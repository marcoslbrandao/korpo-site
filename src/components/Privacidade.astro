---
import Base from '../layouts/Base.astro';
import Topo from './Topo.astro';
import Rodape from './Rodape.astro';
import { rotas, textos, type Lang } from '../i18n/textos';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = textos[lang];
---
<Base lang={lang} pagina="privacidade" titulo={t.priv.titulo}>
  <Topo lang={lang} pagina="privacidade" />
  <main id="conteudo" class="secao secao--branca">
    <article class="texto-legal">
      <h1>{t.priv.titulo}</h1>
      <p>{t.priv.atualizado}</p>
      {t.priv.blocos.map((b) => (
        <section><h2>{b.t}</h2><p>{b.d}</p></section>
      ))}
      <p><a href={rotas.inicio[lang]}>{t.priv.voltar}</a></p>
    </article>
  </main>
  <Rodape lang={lang} />
</Base>
